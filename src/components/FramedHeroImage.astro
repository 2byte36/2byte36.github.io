---
type Props = {
  src: string;
  alt: string;
  class?: string;
  imageClass?: string;
  loading?: "eager" | "lazy";
  backgroundColor?: string;
  label?: string;
};

const {
  src,
  alt,
  class: className = "",
  imageClass = "",
  loading = "eager",
  backgroundColor = "#000000",
  label,
} = Astro.props;
---

<div
  class:list={["relative overflow-hidden", className]}
  style={`aspect-ratio: 3349 / 1200; background-color: ${backgroundColor};`}
>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    class:list={[
      "h-full w-full object-contain object-center",
      imageClass,
    ]}
  />
  {
    label && (
      <span class="absolute bottom-3 right-3 border border-white/40 bg-black/90 px-3 py-1.5 text-xs tracking-widest text-white shadow-lg sm:bottom-4 sm:right-4 sm:text-sm">
        {label}
      </span>
    )
  }
</div>
