---
type Props = {
  src: string;
  alt: string;
  class?: string;
  imageClass?: string;
  loading?: "eager" | "lazy";
  backgroundColor?: string;
};

const {
  src,
  alt,
  class: className = "",
  imageClass = "",
  loading = "eager",
  backgroundColor = "#000000",
} = Astro.props;
---

<div
  class:list={["relative overflow-hidden", className]}
  style={`aspect-ratio: 3349 / 1200; background-color: ${backgroundColor};`}
>
  <img
    src={src}
    alt={alt}
    loading={loading}
    decoding="async"
    class:list={[
      "h-full w-full object-contain object-center",
      imageClass,
    ]}
  />
</div>
