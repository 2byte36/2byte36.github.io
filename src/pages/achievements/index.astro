---
import Layout from "@/layouts/Layout.astro";
import { achievementTimeline } from "@/data/achievements";

const achievements = achievementTimeline.flatMap(({ entries }) => entries);
const podiums = achievements.filter(({ recognition }) =>
  recognition.endsWith("Place"),
).length;
const disclosures = achievements.length - podiums;
---

<Layout
  title="Achievements | 2byte"
  description="A timeline of my cybersecurity competition results, recognized vulnerability disclosures, and community service achievements."
>
  <section
    class="achievements mx-auto max-w-6xl px-4 py-10 md:px-8 md:py-14"
    aria-labelledby="achievements-title"
  >
    <div class="text-center">
      <h1 id="achievements-title" class="text-4xl sm:text-5xl md:text-6xl">
        &lt;Achievements /&gt;
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/65 md:text-lg"
      >
        Competition podiums, responsible disclosures, and milestones along my
        cybersecurity journey.
      </p>
      <dl
        class="mx-auto mt-8 grid max-w-xl grid-cols-3 divide-x divide-white/20 border-y border-white/20 py-5"
      >
        <div class="px-2">
          <dt class="text-xs text-white/60 sm:text-sm">Achievements</dt>
          <dd class="mt-2 text-3xl">
            {String(achievements.length).padStart(2, "0")}
          </dd>
        </div>
        <div class="px-2">
          <dt class="text-xs text-white/60 sm:text-sm">Podiums</dt>
          <dd class="mt-2 text-3xl">{String(podiums).padStart(2, "0")}</dd>
        </div>
        <div class="px-2">
          <dt class="text-xs text-white/60 sm:text-sm">Disclosures</dt>
          <dd class="mt-2 text-3xl">{String(disclosures).padStart(2, "0")}</dd>
        </div>
      </dl>
      <nav
        aria-label="Jump to achievement year"
        class="mt-7 flex flex-wrap justify-center gap-3 text-sm"
      >
        {
          achievementTimeline.map(({ year }) => (
            <a
              href={`#year-${year}`}
              class="border border-white/30 px-4 py-2 transition-colors hover:bg-white hover:text-black"
            >
              {year} <span aria-hidden="true">↓</span>
            </a>
          ))
        }
      </nav>
    </div>

    <div class="mt-14 md:mt-20">
      {
        achievementTimeline.map(({ year, entries }) => (
          <section
            id={`year-${year}`}
            aria-labelledby={`heading-${year}`}
            class="year-group"
          >
            <div class="year-heading">
              <h2 id={`heading-${year}`} class="text-3xl md:text-4xl">
                <time datetime={String(year)}>{year}</time>
              </h2>
              <p class="mt-2 text-xs uppercase tracking-widest text-white/50">
                {String(entries.length).padStart(2, "0")}{" "}
                {entries.length === 1 ? "achievement" : "achievements"}
              </p>
            </div>
            <ol class="timeline" aria-label={`${year} achievements`}>
              {entries.map((achievement) => (
                <li class="timeline-entry">
                  <article class="achievement-card overflow-hidden rounded-lg border border-white/35 bg-white/[0.02] transition-colors hover:border-white/80">
                    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-white/20 px-4 py-3 sm:px-6">
                      <span aria-hidden="true" class="flex gap-1.5">
                        <span class="h-2 w-2 rounded-full bg-white" />
                        <span class="h-2 w-2 rounded-full bg-white/55" />
                        <span class="h-2 w-2 rounded-full bg-white/25" />
                      </span>
                      <span
                        class:list={[
                          "recognition px-2.5 py-1 text-xs sm:text-sm",
                          achievement.recognition.endsWith("Place")
                            ? "bg-white text-black"
                            : "border border-white/40 text-white/85",
                        ]}
                      >
                        {achievement.recognition}
                      </span>
                    </div>
                    <div class="p-4 sm:p-6">
                      <p class="text-xs leading-relaxed text-white/55 sm:text-sm">
                        {achievement.category}
                      </p>
                      <h3 class="mt-3 text-xl leading-snug sm:text-2xl">
                        {achievement.title}
                      </h3>
                      <p class="mt-2 text-sm text-white/70">
                        {achievement.organizer}
                      </p>
                      <p class="mt-4 text-sm leading-7 text-white/75 sm:text-base">
                        {achievement.description}
                      </p>
                      {achievement.writeup && (
                        <a
                          href={achievement.writeup}
                          aria-label={`Read the write-up for ${achievement.title}`}
                          class="mt-5 inline-block text-sm underline decoration-white/40 underline-offset-4 transition-colors hover:decoration-white"
                        >
                          Read write-up <span aria-hidden="true">→</span>
                        </a>
                      )}
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </section>
        ))
      }
    </div>
    <div class="mt-10 border-t border-white/20 pt-6 text-center">
      <a
        href="/blog"
        class="inline-block py-2 text-sm text-white/65 transition-colors hover:text-white"
      >
        Explore my write-ups <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>
</Layout>

<style>
  .achievements a:focus-visible {
    outline: 2px solid white;
    outline-offset: 5px;
  }

  .year-group {
    scroll-margin-top: 9rem;
  }

  .year-group + .year-group {
    margin-top: 3rem;
  }

  .year-heading {
    margin-bottom: 1.5rem;
  }

  .timeline {
    border-left: 1px solid rgb(255 255 255 / 25%);
    margin-left: 0.35rem;
    padding-left: 1.5rem;
  }

  .timeline-entry {
    position: relative;
    padding-bottom: 1.5rem;
  }

  .timeline-entry:last-child {
    padding-bottom: 0;
  }

  .timeline-entry::before {
    content: "";
    position: absolute;
    top: 1.5rem;
    left: calc(-1.5rem - 5px);
    width: 9px;
    height: 9px;
    background: white;
    box-shadow: 0 0 0 5px black;
  }

  .achievement-card {
    overflow-wrap: anywhere;
  }

  @media (min-width: 768px) {
    .year-group {
      display: grid;
      grid-template-columns: 9rem minmax(0, 1fr);
      gap: 2rem;
      scroll-margin-top: 7rem;
    }

    .year-heading {
      align-self: start;
      padding-top: 0.75rem;
    }

    .timeline {
      margin-left: 0;
      padding-left: 2.5rem;
    }

    .timeline-entry::before {
      left: calc(-2.5rem - 5px);
    }
  }
</style>
